# Groq API key (free at https://console.groq.com/keys).
# Without it the app still works in offline keyword mode.
GROQ_API_KEY=

# Optional: any Groq chat model that supports JSON mode.
# If you hit free-tier token limits, try openai/gpt-oss-20b
GROQ_MODEL=openai/gpt-oss-120b

# Optional: comma-separated models used to read sources in parallel.
# Groq rate limits are per model, so two models roughly double throughput.
# GROQ_EXTRACT_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
